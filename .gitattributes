# ==============================================================================
# .gitattributes - Configuración de normalización de saltos de línea (EOL)
# ==============================================================================

# Por defecto, normalizar todos los archivos de texto a LF en el repositorio
* text=auto eol=lf

# Código fuente Java y archivos de configuración / documentación (LF obligatorio)
*.java text eol=lf diff=java
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts de terminal para Linux / macOS (LF obligatorio para ejecución en bash/sh)
*.sh text eol=lf

# Scripts por lotes para Microsoft Windows (CRLF requerido por cmd.exe de Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Archivos binarios (no transformar saltos de línea)
*.class binary
*.jar binary
*.war binary
*.ear binary
*.dat binary
*.bak binary
*.tmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
